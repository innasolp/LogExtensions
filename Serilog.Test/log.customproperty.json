{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Information",
        "Microsoft.AspNetCore": "Information"
      },
      "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithThreadName" ],
      "Properties": {
        "Application": "Serilog.Test"
      }
    },
    "Using": [ "Serilog.ContextFileSink" ],
    "WriteTo": [
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "@l='Fatal' and CustomProperty is not null"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "$[LoggerPath]/{CustomProperty}/Fatal/fatal_.log",
                  "outputTemplate": "{Timestamp:o} [Thread:{ThreadId}] [{Level:u3}] ({CustomProperty}) {Message}{NewLine}{Exception}",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 7
                }
              },
              {
                "Name": "File",
                "Args": {
                  "path": "$[LoggerPath]/{CustomProperty}/Fatal/fatal_.json",
                  "formatter": "Serilog.Formatting.Json.JsonFormatter",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 7
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "@l='Error' and CustomProperty is not null"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "$[LoggerPath]/{CustomProperty}/Error/error_.log",
                  "outputTemplate": "{Timestamp:o} [Thread:{ThreadId}] [{Level:u3}] ({CustomProperty}) {Message}{NewLine}{Exception}",
                  "rollingInterval": "Hour",
                  "retainedFileCountLimit": 7
                }
              },
              {
                "Name": "File",
                "Args": {
                  "path": "$[LoggerPath]/{CustomProperty}/Error/error_.json",
                  "formatter": "Serilog.Formatting.Json.JsonFormatter",
                  "rollingInterval": "Hour",
                  "retainedFileCountLimit": 7
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "@l='Warning' and SourceContext like '%Test%'"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "ContextPropertyFile",
                "Args": {
                  "propertyName": "CustomProperty",
                  "pathFormat": "$[LoggerPath]/{CustomProperty}/Warning/warning_.log",
                  "outputTemplate": "{Timestamp:o} [Thread:{ThreadId}] [{Level:u3}] ({CustomProperty}) {Message}{NewLine}{Exception}",
                  "rollingInterval": "Hour",
                  "retainedFileCountLimit": 7
                }
              },
              {
                "Name": "ContextPropertyFile",
                "Args": {
                  "propertyName": "CustomProperty",
                  "pathFormat": "$[LoggerPath]/{CustomProperty}/Warning/warning_.json",
                  "outputTemplate": "{Timestamp:o} [Thread:{ThreadId}] [{Level:u3}] ({CustomProperty}) {Message}{NewLine}{Exception}",
                  "rollingInterval": "Hour",
                  "retainedFileCountLimit": 7,
                  "formatter": "Serilog.Formatting.Json.JsonFormatter"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "@l='Information' and CustomProperty is not null"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "$[LoggerPath]/Info/info_.log",
                  "outputTemplate": "{Timestamp:o} [Thread:{ThreadId}] [{Level:u3}] {EventId} ({CustomProperty}) {Message}{NewLine}{Exception}",
                  "rollingInterval": "Hour",
                  "retainedFileCountLimit": 7
                }
              },
              {
                "Name": "File",
                "Args": {
                  "path": "$[LoggerPath]/{{CustomProperty}}/Info/info_.json",
                  "formatter": "Serilog.Formatting.Json.JsonFormatter",
                  "rollingInterval": "Hour",
                  "retainedFileCountLimit": 7
                }
              }
            ]
          }
        }
      }
    ]
  }
}

